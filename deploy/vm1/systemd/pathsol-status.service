# Plan 18: status.json says "up" while VM1 runs and when it comes back after a
# shutdown. Stopping runs before the network goes down, because of After=.
[Unit]
Description=PathSolutions v3 status.json
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pathsol-status up
ExecStop=/usr/local/sbin/pathsol-status down
TimeoutStartSec=60
TimeoutStopSec=60
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
